% アブストラクト本文を両学位区分で同じ書式にするための共通命令．
\newcommand{\AbstractSection}[1]{%
  \par\medskip\noindent\textbf{#1}\par\nobreak\smallskip}
\newcommand{\AbstractPageBreak}{}

% 奥付だけ短い所属表記にしたい場合は\ColophonAffiliationで上書きする．
\newcommand{\UsamiColophonAffiliationText}{%
  \ifdefempty{\UsamiColophonAffiliation}
    {\UsamiAffiliation}
    {\UsamiColophonAffiliation}}

% examples/にだけ用いる統一注記．提出原稿へは読み込まれない．
\newcommand{\UsamiFictionalExampleNotice}{%
