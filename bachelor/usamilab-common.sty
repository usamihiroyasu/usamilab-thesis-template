\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usamilab-common}[2026/07/29 v2.0.1 Usami Lab common definitions]

\RequirePackage{etoolbox}
\input{usamilab-profile}

% 修士論文だけで用いる図目次・表目次の出力設定．
% 設定行がない旧metadata.texでは修士をON，卒論をOFFとする．
\newif\ifUsamiListOfFigures
\newif\ifUsamiListOfTables
\ifUsamiMaster
  \UsamiListOfFigurestrue
  \UsamiListOfTablestrue
\else
  \UsamiListOfFiguresfalse
  \UsamiListOfTablesfalse
\fi
\newcommand{\UsamiShowListOfFigures}[1]{%
  \ifstrequal{#1}{true}
    {\UsamiListOfFigurestrue}
    {\ifstrequal{#1}{false}
       {\UsamiListOfFiguresfalse}
       {\PackageError{usamilab-common}
          {\string\UsamiShowListOfFigures の値 `#1' は不正です}
          {true または false を指定してください}}}}
\newcommand{\UsamiShowListOfTables}[1]{%
  \ifstrequal{#1}{true}
    {\UsamiListOfTablestrue}
    {\ifstrequal{#1}{false}
       {\UsamiListOfTablesfalse}
       {\PackageError{usamilab-common}
          {\string\UsamiShowListOfTables の値 `#1' は不正です}
          {true または false を指定してください}}}}

